{% extends 'emails/base.html.twig' %}

{% block content %}
<mj-section>
  <mj-column>
    <mj-text font-size="20px" font-weight="bold">
      Réinitialisation de votre mot de passe
    </mj-text>
    <mj-text>
      Bonjour {{ user.firstName }}, vous avez demandé une réinitialisation de votre mot de passe. Cliquez sur le bouton ci-dessous pour continuer.
    </mj-text>
    <mj-button href="{{ resetLink }}" background-color="#3b82f6" font-weight="bold">
      Réinitialiser mon mot de passe
    </mj-button>
    <mj-text font-size="14px" color="#6b7280">
      Ce lien expire dans 1 heure. Si vous n'avez pas demandé cette réinitialisation, ignorez cet email.
    </mj-text>
  </mj-column>
</mj-section>
{% endblock %}
