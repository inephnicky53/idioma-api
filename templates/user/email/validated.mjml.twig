{% extends 'base_email.mjml.twig' %}

{% block title %}{{ subject }}{% endblock %}

{% block email_content %}

    <mj-section background-color="#ffffff" padding-left="15px" padding-right="15px">
        <mj-column width="100%">
            <mj-text color="#212b35" font-weight="bold" font-size="20px">
                Cher/Chère {{ user }},
            </mj-text>
            <mj-text color="#637381" font-size="16px">
                Votre compte vient d'être validé avec succès, <br>
                vous pouvez donc apprendre les langues de votre choix en tout sécurité
            </mj-text>
            <mj-button background-color="{{ platform.primary_color }}" align="center" color="#ffffff" font-size="17px"
                       font-weight="bold" href="{{ platform.url }}/login" width="300px">
                Connectez-vous
            </mj-button>
            <mj-text color="#637381" font-size="16px" padding-top="30px">

                N'hésitez pas à nous contacter si vous avez la moindre question. Nous serons ravis de
                vous aider à atteindre vos objectifs linguistiques.
            </mj-text>
            <mj-text color="#637381" font-size="16px" padding-bottom="0">
                Bonne découverte et bon apprentissage !
            </mj-text>
            <mj-text color="#637381" font-size="16px" padding-bottom="0">
                L'équipe {{ platform.name }}
            </mj-text>
        </mj-column>
    </mj-section>
{% endblock %}

