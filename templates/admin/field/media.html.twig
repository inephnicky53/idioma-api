{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{# @var field \EasyCorp\Bundle\EasyAdminBundle\Dto\FieldDto #}
{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}
{# this is a bit ugly, but Twig doesn't have a 'is numeric' test #}
{% set media = entity.instance.thumbnails %}
{% if ea.crud.currentAction == 'index' %}
    {% set list = media|slice(0, 2) %}
    {% set width = "inherit" %}
{% else %}
    {% set list = media %}
    {% set width = "100px" %}
{% endif %}

{% for media in list %}
    {% if media.name is not null %}
        {% set html_id = 'ea-lightbox-' ~ field.uniqueId ~ '-' ~ loop.index %}
        <a href="#" class="ea-lightbox-thumbnail" data-ea-lightbox-content-selector="#{{ html_id }}">
            <img src="{{ vich_uploader_asset(media, 'file') }}" class="img-fluid" style="width: {{ width }};"
                 alt="image">
        </a>

        <div id="{{ html_id }}" class="ea-lightbox">
            <img src="{{ vich_uploader_asset(media, 'file') }}" alt="image">
        </div>
    {% endif %}
{% endfor %}
