{% if field.value is not empty %}
    <div class="chat-container">
        <div class="messages-list">
            {% set previousMessage = null %}
            {% for message in field.value %}
                {% set isAuthor = message.thread.teacher.user.id == message.author.id %}
                {% set showAvatar = previousMessage is null or previousMessage.author.id != message.author.id %}
                {% set showDate = previousMessage is null or previousMessage.createdAt|date('Ymd') != message.createdAt|date('Ymd') %}
                
                {% if showDate %}
                    <div class="date-separator">
                        <span>{{ message.createdAt|date('d/m/Y') }}</span>
                    </div>
                {% endif %}
                
                <div class="message-wrapper {{ isAuthor ? 'author' : 'participant' }}">
                    {% if showAvatar and not isAuthor %}
                        <div class="avatar">
                            {% if message.author.thumbnail %}
                                <img src="{{ vich_uploader_asset(message.author.thumbnail, 'file') }}" 
                                     alt="{{ message.author }}" 
                                     class="avatar-img">
                            {% else %}
                                <div class="avatar-placeholder">
                                    {{ message.author|first|upper }}
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                    
                    <div class="message-content">
                        {% if message.tagMessage %}
                            <div class="tagged-message">
                                <i class="fas fa-reply"></i>
                                {{ message.tagMessage.body|striptags|truncate(50) }}
                            </div>
                        {% endif %}
                        
                        <div class="message-body">
                            {{ message.body|nl2br }}
                        </div>
                        
                        <div class="message-time">
                            {{ message.createdAt|date('H:i') }}
                        </div>
                    </div>
                </div>
                
                {% set previousMessage = message %}
            {% endfor %}
        </div>
    </div>
{% else %}
    <div class="alert alert-info">
        <i class="fas fa-comments"></i>
        Aucun message dans cette conversation
    </div>
{% endif %}

<style>
:root {
    --chat-bg: #f8f9fa;
    --chat-border: #dee2e6;
    --message-bg: #ffffff;
    --message-author-bg: #0d6efd;
    --message-text: #212529;
    --message-author-text: #ffffff;
    --date-separator-bg: #6c757d;
    --date-separator-text: #ffffff;
    --avatar-bg: #6c757d;
    --tagged-bg: rgba(0,0,0,0.1);
}

[data-bs-theme="dark"] {
    --chat-bg: #1a202c;
    --chat-border: #2d3748;
    --message-bg: #2d3748;
    --message-author-bg: #4299e1;
    --message-text: #e2e8f0;
    --message-author-text: #ffffff;
    --date-separator-bg: #4a5568;
    --date-separator-text: #e2e8f0;
    --avatar-bg: #4a5568;
    --tagged-bg: rgba(255,255,255,0.1);
}

.chat-container {
    max-height: 400px;
    overflow-y: auto;
    border: 1px solid var(--chat-border);
    border-radius: 8px;
    background: var(--chat-bg);
}

.messages-list {
    padding: 16px;
}

.date-separator {
    text-align: center;
    margin: 16px 0;
}

.date-separator span {
    background: var(--date-separator-bg);
    color: var(--date-separator-text);
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 0.8rem;
}

.message-wrapper {
    display: flex;
    margin-bottom: 12px;
    gap: 8px;
}

.message-wrapper.author {
    justify-content: flex-end;
}

.avatar {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
}

.avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
}

.avatar-placeholder {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--avatar-bg);
    color: var(--date-separator-text);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
}

.message-content {
    max-width: 70%;
    background: var(--message-bg);
    color: var(--message-text);
    padding: 12px;
    border-radius: 12px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    transition: all 0.2s ease;
}

.author .message-content {
    background: var(--message-author-bg);
    color: var(--message-author-text);
}

.tagged-message {
    font-size: 0.8rem;
    opacity: 0.7;
    margin-bottom: 8px;
    padding: 4px 8px;
    background: var(--tagged-bg);
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 4px;
}

.message-time {
    font-size: 0.75rem;
    opacity: 0.7;
    margin-top: 4px;
    text-align: right;
}

@media (max-width: 768px) {
    .message-content {
        max-width: 85%;
    }
}
</style>
