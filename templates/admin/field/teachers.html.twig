{% if field.value is not empty %}
    <div class="teachers-list">
        {% for userTeacher in field.value %}
            {% set detailUrl = ea_url()
                .setController('App\\Controller\\Admin\\Teacher\\TeacherCrudController')
                .setAction(constant('EasyCorp\\Bundle\\EasyAdminBundle\\Config\\Action::DETAIL'))
                .setEntityId(userTeacher.teacher.id) %}
            <div class="teacher-item">
                <div class="teacher-info">
                    <h6 class="teacher-name">
                        <a href="{{ detailUrl }}" class="teacher-link">
                            <i class="fas fa-chalkboard-teacher"></i>
                            {{ userTeacher.teacher }}
                        </a>
                    </h6>
                    
                    <div class="teacher-details">
                        <div class="hours-info">
                            {% if userTeacher.hours > 0 %}
                                <i class="fas fa-clock text-success"></i>
                                <span class="hours-positive">
                                    {{ "user.hours.with_number"|trans({"number": userTeacher.hours}) }}
                                </span>
                            {% else %}
                                <i class="fas fa-clock text-warning"></i>
                                <span class="hours-empty">{{ 'user.hours.empty'|trans }}</span>
                            {% endif %}
                        </div>
                        
                        <div class="added-date">
                            <i class="fas fa-calendar-plus"></i>
                            Ajouté le {{ userTeacher.createdAt|date('d/m/Y à H:i') }}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="alert alert-info">
        <i class="fas fa-user-times"></i>
        Aucun idiomaster suivi
    </div>
{% endif %}

<style>
:root {
    --teacher-bg: #ffffff;
    --teacher-border: #dee2e6;
    --teacher-text: #212529;
    --teacher-muted: #6c757d;
    --teacher-link: #0d6efd;
    --teacher-success: #28a745;
    --teacher-warning: #ffc107;
}

[data-bs-theme="dark"] {
    --teacher-bg: #2d3748;
    --teacher-border: #4a5568;
    --teacher-text: #e2e8f0;
    --teacher-muted: #a0aec0;
    --teacher-link: #63b3ed;
    --teacher-success: #48bb78;
    --teacher-warning: #ed8936;
}

.teachers-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.teacher-item {
    padding: 16px;
    border: 1px solid var(--teacher-border);
    border-radius: 8px;
    background: var(--teacher-bg);
    color: var(--teacher-text);
    transition: all 0.2s ease;
}

.teacher-item:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transform: translateY(-1px);
}

[data-bs-theme="dark"] .teacher-item:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
}

.teacher-name {
    margin: 0 0 8px 0;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.teacher-link {
    text-decoration: none;
    color: var(--teacher-link);
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    transition: all 0.2s ease;
}

.teacher-link:hover {
    text-decoration: underline;
    opacity: 0.8;
}

.trial-badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    display: flex;
    align-items: center;
    gap: 4px;
}

.teacher-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.9rem;
}

.hours-info, .added-date {
    display: flex;
    align-items: center;
    gap: 6px;
}

.hours-positive {
    color: var(--teacher-success);
    font-weight: 500;
}

.hours-empty {
    color: var(--teacher-warning);
    font-weight: 500;
}

.added-date {
    color: var(--teacher-muted);
}

@media (max-width: 768px) {
    .teacher-name {
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
    }
    
    .teacher-details {
        font-size: 0.8rem;
    }
}
</style>
