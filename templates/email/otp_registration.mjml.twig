{% extends 'base_email.mjml.twig' %}

{% block title %}{{ subject }}{% endblock %}

{% block email_content %}
    <mj-section background-color="#ffffff" padding-left="15px" padding-right="15px">
        <mj-column width="100%">
            <mj-text color="#212b35" font-weight="bold" font-size="20px">
                Code de vérification
            </mj-text>
            <mj-text color="#637381" font-size="16px">
                Bonjour,
            </mj-text>
            <mj-text color="#637381" font-size="16px">
                Bienvenue sur {{ platform.name }} ! Pour finaliser votre inscription, veuillez utiliser le code de vérification ci-dessous :
            </mj-text>
            <mj-section background-color="#f8f9fa" padding="20px" border-radius="8px">
                <mj-column width="100%">
                    <mj-text color="{{ platform.primary_color }}" font-weight="bold" font-size="32px" align="center" letter-spacing="8px" font-family="monospace">
                        {{ data.otp }}
                    </mj-text>
                </mj-column>
            </mj-section>
            <mj-text color="#637381" font-size="16px">
                Ce code expire dans {{ data.expiry_minutes }} minutes.
            </mj-text>
            <mj-text color="#637381" font-size="14px" color="#dc3545">
                Si vous n'avez pas demandé ce code, veuillez ignorer cet email.
            </mj-text>
            <mj-text color="#637381" font-size="16px" padding-top="30px">
                Merci de votre confiance !
            </mj-text>
            <mj-text color="#637381" font-size="16px" padding-bottom="0">
                L'équipe {{ platform.name }}
            </mj-text>
        </mj-column>
    </mj-section>
{% endblock %}