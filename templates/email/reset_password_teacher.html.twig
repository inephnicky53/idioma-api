{% extends 'base_email.mjml.twig' %}

{% block title %}{{ subject }}{% endblock %}

{% block email_content %}
    <mj-section background-color="#ffffff" padding-left="15px" padding-right="15px">
        <mj-column width="100%">
            <mj-text color="#212b35" font-weight="bold" font-size="20px">
                Réinitialisation de mot de passe
            </mj-text>
            <mj-text color="#637381" font-size="16px">
                Cher/Chère {{ user.fullname }},
            </mj-text>
            <mj-text color="#637381" font-size="16px">
                Nous avons reçu une demande de réinitialisation de votre mot de passe pour votre compte professeur.
            </mj-text>
            <mj-text color="#637381" font-size="16px">
                Votre mot de passe a été réinitialisé avec succès. Vous pouvez maintenant vous connecter avec votre nouveau mot de passe.
            </mj-text>
            <mj-button background-color="#3d165b" align="center" color="#ffffff" font-size="17px"
                       font-weight="bold" href="{{ idioma.teacher_dashboard }}" width="300px">
                Accéder au tableau de bord
            </mj-button>
            <mj-text color="#637381" font-size="16px" padding-top="30px">
                Si vous n'avez pas demandé cette réinitialisation, veuillez nous contacter immédiatement.
            </mj-text>
            <mj-text color="#637381" font-size="16px" padding-bottom="0">
                L'équipe {{ idioma.name }}
            </mj-text>
        </mj-column>
    </mj-section>
{% endblock %}

