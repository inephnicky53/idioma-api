{% extends 'base_email.mjml.twig' %}

{% block title %}{{ subject }}{% endblock %}

{% block email_content %}
    <mj-section background-color="#ffffff" padding-left="15px" padding-right="15px">
        <mj-column width="100%">
            <mj-text color="#212b35" font-weight="bold" font-size="20px">
                Transaction confirmée !
            </mj-text>
            <mj-text color="#637381" font-size="16px">
                Cher/Chère {{ data.transaction.user.fullname }},
            </mj-text>
            <mj-text color="#637381" font-size="16px">
                Excellente nouvelle ! Votre transaction a été confirmée avec succès.
            </mj-text>
            
            <mj-divider border-color="#e5e7eb" border-width="1px" padding="20px 0"></mj-divider>
            
            <mj-text color="#212b35" font-weight="bold" font-size="16px">
                Détails de la transaction :
            </mj-text>
            <mj-text color="#637381" font-size="14px">
                <strong>Référence :</strong> {{ data.transaction.reference }}
            </mj-text>
            <mj-text color="#637381" font-size="14px">
                <strong>Montant :</strong> {{ data.transaction.amount }} {{ data.transaction.currency.min }}
            </mj-text>
            <mj-text color="#637381" font-size="14px">
                <strong>Opérateur :</strong> {{ data.transaction.operator }}
            </mj-text>
            <mj-text color="#637381" font-size="14px">
                <strong>Date de confirmation :</strong> {{ data.transaction.respondedAt|date('d/m/Y à H:i') }}
            </mj-text>
            
            {% if data.transaction.command %}
                <mj-text color="#212b35" font-weight="bold" font-size="16px" padding-top="20px">
                    Votre commande est maintenant active :
                </mj-text>
                <mj-text color="#637381" font-size="14px">
                    <strong>Référence :</strong> {{ data.transaction.command.reference }}
                </mj-text>
                <mj-text color="#637381" font-size="14px">
                    <strong>Statut :</strong> Confirmée ✅
                </mj-text>
            {% endif %}
            
            <mj-divider border-color="#e5e7eb" border-width="1px" padding="20px 0"></mj-divider>
            
            <mj-text color="#637381" font-size="16px">
                Votre paiement a été traité avec succès. Vous pouvez maintenant profiter pleinement de vos services.
            </mj-text>
            
            <mj-button background-color="#3d165b" align="center" color="#ffffff" font-size="17px"
                       font-weight="bold" href="{{ idioma.dashboard }}" width="300px">
                Accéder à mes services
            </mj-button>
            
            <mj-text color="#637381" font-size="16px" padding-top="30px">
                Merci de votre confiance !
            </mj-text>
            <mj-text color="#637381" font-size="16px" padding-bottom="0">
                L'équipe {{ idioma.name }}
            </mj-text>
        </mj-column>
    </mj-section>
{% endblock %}