{% extends '@EasyAdmin/crud/page_layout.html.twig' %}

{% block page_title %}Réinitialiser le mot de passe - {{ entity.instance.firstName }} {{ entity.instance.lastName }}{% endblock %}

{% block main %}
    <div class="content-header">
        <h1>{{ 'Réinitialiser le mot de passe'|trans }}</h1>
    </div>

    <div class="content-body">
        <div class="alert alert-info">
            <p>Vous allez réinitialiser le mot de passe de {{ entity.instance.firstName }} {{ entity.instance.lastName }} ({{ entity.instance.email }}).</p>
        </div>

        <form method="post" action="">
            <div class="field-group">
                <div class="field-label">
                    <label for="new_password">Nouveau mot de passe</label>
                </div>
                <div class="field-widget">
                    <input type="password" id="new_password" name="new_password" minlength="6" required class="form-control">
                </div>
            </div>

            <div class="form-actions">
                <a href="{{ ea_url().setController(App\\Controller\\Admin\\UserCrudController::class).setAction('detail').setEntityId(entity.instance.id) }}" class="btn btn-secondary">
                    Annuler
                </a>
                <button type="submit" class="btn btn-primary">
                    Réinitialiser le mot de passe
                </button>
            </div>
        </form>
    </div>
{% endblock %}
