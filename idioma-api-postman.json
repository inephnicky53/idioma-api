                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{api_url}}/dashboard/profile",
              "host": ["{{api_url}}"],
              "path": ["api", "dashboard", "profile"]
            }
          }
        },
