    {
      "name": "✅ Check-in",
      "item": [
        {
          "name": "Create Check-in - Arrivée",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location\": \"Paris\"\n}"
            },
            "url": {
              "raw": "{{api_url}}/check-in",
              "host": ["{{api_url}}"],
              "path": ["api", "check-in"]
            }
          }
        },
