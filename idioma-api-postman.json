{
  "info": {
    "_postman_id": "idioma-api-v2",
    "name": "Idioma API v2.0.0",
    "description": "API REST pour la gestion des abonnements et check-ins",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 Authentification",
      "item": [
        {
          "name": "Register - Créer un compte",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Test123!@\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"+33612345678\"\n}"
            },
            "url": {
              "raw": "{{api_url}}/auth/register",
              "host": ["{{api_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login - Se connecter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{api_url}}/login_check",
              "host": ["{{api_url}}"],
              "path": ["api", "login_check"]
            }
          }
        }
      ]
    },
    {
      "name": "📊 Dashboard",
      "item": [
        {
          "name": "Get Profile - Mon profil",
          "request": {
            "method": "GET",
            "header": [
